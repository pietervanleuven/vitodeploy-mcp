{
    "$schema": "https://raw.githubusercontent.com/vitodeploy/plugins/main/schema/manifest.schema.json",
    "name": "pietervanleuven/vitodeploy-mcp",
    "description": "MCP server for VitoDeploy: manage servers, sites, deployments, databases, workers and more from Claude and other AI agents, using your Vito API keys",
    "version": "0.4.0",
    "type": "vito-plugin",
    "license": "MIT",
    "keywords": [
        "vitodeploy",
        "vitodeploy-plugin",
        "mcp",
        "model-context-protocol",
        "ai",
        "claude"
    ],
    "authors": [
        {
            "name": "Pieter Van Leuven",
            "homepage": "https://github.com/pietervanleuven"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\Vito\\Plugins\\Pietervanleuven\\VitodeployMcp\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "extra": {
        "vito": {
            "name": "MCP Server",
            "categories": [
                "ai",
                "api"
            ],
            "homepage": "https://github.com/pietervanleuven/vitodeploy-mcp",
            "repository": "https://github.com/pietervanleuven/vitodeploy-mcp",
            "author": {
                "name": "Pieter Van Leuven",
                "github": "pietervanleuven"
            },
            "official": false,
            "min_vito_version": "4.1.0",
            "icon": "assets/icon.svg"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
